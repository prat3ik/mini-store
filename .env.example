# Copy to .env. Everything has a default.

# Where the tests point. The dev server runs on :3100.
BASE_URL=http://localhost:3100

# TestDino → project → Settings → API keys. Leave empty to run without streaming.
TESTDINO_TOKEN=

# "chrome" uses the installed Google Chrome (needed on macOS 13). Use "chromium" elsewhere.
BROWSER_CHANNEL=chrome
